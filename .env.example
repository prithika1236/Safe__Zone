# ============================================================
# SafeZone Environment Configuration Template
# ============================================================

# Application & Network
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://10.0.2.2:8000"]

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:Jaya@1236@localhost:5432/safezone_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:Jaya@1236@localhost:5432/safezone_db

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mobile Configuration Strategy
# (On physical Android devices, use your laptop's local LAN IP e.g., http://192.168.1.50:8000)
MOBILE_API_BASE_URL=http://10.0.2.2:8000

# Routing & Geospatial
ROUTING_SERVICE_URL=http://router.project-osrm.org
DEFAULT_COVERAGE_RADIUS_KM=3.0

# Deep Learning Crime Classifier
CLASSIFICATION_MODEL_PATH=backend/app/ml/saved_models/bilstm_crime_classifier.keras
CLASSIFICATION_TOKENIZER_PATH=backend/app/ml/saved_models/tokenizer.json
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75

# Risk Engine & Optimization Configuration
RISK_RECENCY_LAMBDA=0.05
DEFAULT_PATROL_COUNT=10

# Firebase Cloud Messaging Abstraction
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
