# ==============================================================================
# SafeZone Backend Configuration Template (.env.example)
# Copy to .env and configure for your local development or production environment.
# ==============================================================================

PROJECT_NAME=SafeZone
VERSION=1.0.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Server Network Binding (Use 0.0.0.0 for LAN/Emulator access, 127.0.0.1 for local only)
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:Jaya@1236@localhost:5432/safezone_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:Jaya@1236@localhost:5432/safezone_db

# Security & Authentication (Replace JWT_SECRET with a strong 32+ character key)
JWT_SECRET=safezone-insecure-dev-secret-key-change-in-production-32char
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mobile API Configuration (Default for Android Emulator)
MOBILE_API_BASE_URL=http://10.0.2.2:8000

# Optimization & Risk Parameters
DEFAULT_COVERAGE_RADIUS_KM=3.0
RISK_RECENCY_LAMBDA=0.05
DEFAULT_PATROL_COUNT=10

# External Notifications (Leave blank for DEV_IN_APP / local console delivery)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
